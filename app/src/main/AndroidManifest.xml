<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading the hardware step counter is activity data, so it is permission-guarded. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Asked for from Settings, so the quarter-hourly counter read is not deferred away. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android stops delivering sensor events to an app whose UID has gone idle, so counting from
         a pocket needs a foreground service. Its notification is the step count itself, which is
         why posting notifications is asked for too. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A restart leaves the app installed and scheduled but not running, and nothing counts until
         something starts it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The app is useless without the counter, but it must still install on devices that lack
         it: the UI says so instead of the store hiding the app. -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <!-- Platform backup is off: the step history moves between phones through the app's own
         CSV and ZIP export, which the user triggers and can inspect. -->
    <application
        android:name=".StepsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Steps">

        <!-- Android 16 ignores an activity's orientation lock unless the app opts back in. This
             is a one-hand phone app: a ring and a bar chart laid out for a tall screen. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_ORIENTATION"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: nothing outside the app has any business starting the counting. -->
        <service
            android:name=".work.StepsService"
            android:exported="false"
            android:foregroundServiceType="health|dataSync" />

        <!-- Not exported beyond the system broadcasts it is registered for. -->
        <receiver
            android:name=".work.StepsBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
